{
  "description": "Ссылка со схемой javascript:",
  "expect": [
    {
      "code": "IR_SCHEMA_VIOLATION",
      "pointer": "/nodes/n_link/on/click/args/to/url"
    }
  ],
  "document": {
    "irVersion": "1.0",
    "kind": "page",
    "root": "n_root",
    "nodes": {
      "n_root": {
        "id": "n_root",
        "type": "Box",
        "children": ["n_text", "n_link"]
      },
      "n_text": {
        "id": "n_text",
        "type": "Text",
        "bindings": {
          "text": "$local.t_hello"
        }
      },
      "n_link": {
        "id": "n_link",
        "type": "Button",
        "on": {
          "click": {
            "action": "navigate",
            "args": {
              "to": {
                "kind": "url",
                "url": "javascript:alert(1)"
              }
            }
          }
        }
      }
    },
    "localContent": {
      "t_hello": {
        "type": "text",
        "value": {
          "ru": "Привет"
        }
      }
    }
  }
}
