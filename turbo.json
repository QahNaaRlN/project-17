{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "tasks": {
    "gen": {
      "outputs": ["src/generated/**", "internal/**/*_gen.*"],
      "dependsOn": ["^gen"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**", "coverage.out"]
    },
    "lint": {}
  }
}
