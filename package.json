{
  "name": "cms",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test --concurrency=1",
    "typecheck": "turbo run typecheck",
    "lint": "eslint . && turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen": "turbo run gen",
    "e2e:scenario": "node scripts/e2e-scenario.mjs",
    "load": "node perf/run.mjs",
    "spec:check": "node scripts/spec-trace.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.19.0",
    "eslint": "^9.39.0",
    "prettier": "^3.6.0",
    "turbo": "^2.6.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "4.1.12"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "^0.28.1",
      "fast-uri": "^3.1.9",
      "qs": "^6.16.0",
      "zod": "^4.6.6"
    }
  }
}
