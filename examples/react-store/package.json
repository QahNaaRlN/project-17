{
  "name": "@cms/store-example",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx src/server.ts",
    "build": "pnpm manifest:build && vite build && vite build --ssr src/server.ts --outDir dist/server",
    "start": "node dist/server/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:e2e": "pnpm exec turbo run build --filter @cms/studio && playwright test",
    "test:mutation": "stryker run",
    "seed": "pnpm manifest:build && node --import tsx scripts/seed.ts",
    "preview:renew": "node --import tsx scripts/renew-preview.ts",
    "manifest:build": "cms manifest build --registry src/registry.ts --export registry --root ../.. --tsconfig tsconfig.json --app-id store-example --app-version 1.0.0 --framework react"
  },
  "dependencies": {
    "@cms/core": "workspace:*",
    "@cms/runtime": "workspace:*",
    "@cms/react": "workspace:*",
    "@radix-ui/react-dialog": "1.1.15",
    "lucide-react": "0.468.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "@cms/component-registry": "workspace:*"
  },
  "devDependencies": {
    "@cms/ir": "workspace:*",
    "@cms/manifest": "workspace:*",
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "4.3.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/jsdom": "21.1.7",
    "jsdom": "26.1.0",
    "@vitejs/plugin-react": "5.0.4",
    "@vitest/coverage-v8": "4.1.11",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "fast-check": "^4.10.2",
    "tailwindcss": "4.3.0",
    "tsx": "4.20.6",
    "vite": "7.3.1"
  }
}
